# Image API keys — copy this file to .env and fill in your key(s)
# Never commit .env to git (it's in .gitignore)

# ── Unsplash (PRIMARY — recommended) ─────────────────────────
# Free key: https://unsplash.com/developers
# Free tier: 5 000 requests / hour
UNSPLASH_ACCESS_KEY=

# ── Pexels (ALTERNATIVE) ──────────────────────────────────────
# Free key: https://www.pexels.com/api/
# Free tier: 200 requests / hour
PEXELS_API_KEY=

# ── MongoDB (only needed for --from-mongo mode) ───────────────
# Same value as tamreen-ai/apps/web/.env.local  DATABASE_URL
DATABASE_URL=mongodb://admin:tamreen_dev@localhost:27017/tamreen?authSource=admin
